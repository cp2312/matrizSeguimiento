PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/matriz_seguimiento
JWT_SECRET=<cadena larga y aleatoria>
JWT_EXPIRES_IN=8h

# Correo de aviso de pendientes (Outlook / Microsoft 365).
# Con SMTP_USER o SMTP_PASS vacíos, el envío se omite (queda registrado en el log) sin romper nada.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
